  "cards": [
    {
      "dot": "cyan",
      "title": "One browser runtime",
      "items": [
        "Views emit callbacks; App owns state and passes props.",
        "Helpers return values; only the adapter accesses localStorage."
      ]
    },
    {
      "dot": "amber",
      "title": "Deliberate tradeoff",
      "items": [
        "No accounts or sync: progress stays with this origin/profile.",
        "App saves on state change; storage access errors are unhandled."
      ]
    },
    {
      "dot": "violet",
      "title": "Practice, not assessment",
      "items": [
        "Bank and answer keys ship in the client; no AI or Databricks API.",
        "Tests exercise selection, UI and reload/reset; no exam outcome proof."
      ]
    }
  ]
